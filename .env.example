
PORT=:8080

# postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mydb
DB_USER=user
DB_PASSWORD=change_me
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# auth
# Used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_string

# logging
# APP_ENV: development | production
APP_ENV=development
# LOG_LEVEL: trace | debug | info | warn | error
LOG_LEVEL=info
LOG_DIRECTORY=logs
# Leave unset to log to stdout only; set a filename to also write to disk.
# LOG_FILE=app.log

# mongodb (optional)
# Only needed if you enable the Mongo logrus hook in app/application.go.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=logdb
MONGO_COLLECTION_NAME=logs

# file system
TEXT_FILE_DIRECTORY="./file_data/text_file/users.txt"
COMPRESSED_FILE_DIRECTORY="./file_data/text_file/users_compressed.txt"
KV_FILE_DIRECTORY="./file_data/text_file/users_kv.txt"
